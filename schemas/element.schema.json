{
  "$id": "element.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Element",
  "type": "object",
  "required": ["id", "type", "page", "bbox", "source", "needs_review"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["heading", "paragraph", "table", "figure", "equation", "code", "list", "caption"]
    },
    "page": { "type": "integer", "minimum": 1 },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "description": "[x0, y0, x1, y1], normalized 0-1"
    },
    "text": { "type": "string" },
    "source": { "type": "string", "enum": ["script", "florence", "qwen-vl", "groq", "overlap"] },
    "needs_review": { "type": "boolean" },
    "error": { "type": "string" },

    "level": { "type": "integer", "minimum": 1, "maximum": 6 },

    "rows": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "string" } }
    },
    "header_rows": { "type": "integer", "minimum": 0 },
    "caption": { "type": ["string", "null"] },
    "continues_from": { "type": ["string", "null"] },
    "continues_to": { "type": ["string", "null"] },
    "truncated_rows": { "type": "integer", "minimum": 0 },

    "figure_type": {
      "type": "string",
      "enum": [
        "bar_chart", "line_chart", "scatter", "pie_chart", "flowchart",
        "uml", "schematic", "photo", "screenshot", "table_image", "other"
      ]
    },
    "description": { "type": "string" },
    "data": {
      "type": ["object", "null"],
      "description": "Type-specific payload: chart x/series/values (marked as estimates), flowchart nodes/edges, photo description; null when unavailable (paired with needs_review)",
      "additionalProperties": true
    },
    "overlap_of": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "table" } } },
      "then": { "required": ["rows", "header_rows"] }
    },
    {
      "if": { "properties": { "type": { "const": "figure" } } },
      "then": { "required": ["figure_type", "description"] }
    }
  ]
}
