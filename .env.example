# Figure Extraction — environment
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# Every variable read anywhere in this repository is documented here:
# JavaScript (src/config.js), Python clients (figure_extraction/*.py),
# and the Modal vLLM app (modal/vllm_app.py, read at DEPLOY time).

# ==========================================================================
# Florence endpoints (figure extraction; used by pipeline.py / pdf_to_json.py
# and by the JS hybrid-florence mode)
# ==========================================================================
# URL printed by `modal deploy figure_extraction/florence.py`
# (or written automatically by scripts/setup_modal.sh)
MODAL_FLORENCE_URL=
# Random secret generated once with `openssl rand -hex 32`; the endpoints expect
# it as either the `X-API-Secret` header or `Authorization: Bearer`.
# Stored in the `florence-api` Modal secret; shared by ALL Modal apps.
MODAL_API_SECRET=
# URL printed by `modal deploy figure_extraction/florence_pdf.py` — the
# PDF→JSON app. Used by figure_extraction/pdf_to_json.py and JS hybrid-florence.
MODAL_PDF_EXTRACT_URL=

# --- Vision model (server-side; the Florence secret also carries this) ---
# florence-2-base | florence-2-large  (maps to microsoft/Florence-2-*-ft)
VISION_MODEL=florence-2-large

# ==========================================================================
# Modal-hosted Qwen-VL endpoints (separate apps, same secret as Florence)
# Deploy: python -m modal deploy modal/full-qwen8b.py  (T4 / commodity GPU)
#          python -m modal deploy modal/full-qwen27b.py (A100-40GB)
# ==========================================================================
# URL printed by `python -m modal deploy modal/full-qwen8b.py`
MODAL_FULL_QWEN_8B_URL=
# Qwen/Qwen3-VL-8B-Instruct-FP8 by default (~9 GB); override to swap models
MODAL_FULL_QWEN_8B_MODEL=Qwen/Qwen3-VL-8B-Instruct-FP8
# URL printed by `python -m modal deploy modal/full-qwen27b.py`
MODAL_FULL_QWEN_27B_URL=
# Qwen/Qwen3.8-27B-Instruct-FP8 by default (~30 GB); override to swap models
MODAL_FULL_QWEN_27B_MODEL=Qwen/Qwen3.8-27B-Instruct-FP8

# ==========================================================================
# Chunked-manifest extraction modes (src/cli.js -> src/extractDocument.js)
# ==========================================================================

# --- Mode full-groq: Groq API (OpenAI-compatible; qwen/qwen3.8-27b by default) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Documented limits for qwen/qwen3.8-27b: <=3 images/request, <=20MB/request,
# 2048 prompt tokens per image, 131K context.
GROQ_MODEL=qwen/qwen3.8-27b

# --- Mode full-modal: Modal-hosted vLLM (OpenAI-compatible; see modal/vllm_app.py) ---
# URL printed by `python -m modal deploy modal/vllm_app.py`; the JS appends
# /v1/chat/completions.
MODAL_ENDPOINT_URL=
# The model served by the vLLM app. Must be a HF repo id that exists and is
# supported by vLLM (e.g. Qwen/Qwen3-VL-4B-Instruct).
VLLM_MODEL=Qwen/Qwen3-VL-4B-Instruct

# ==========================================================================
# Shared knobs for the extraction modes (chunking, caching, retries, cost)
# ==========================================================================
DPI=170
# Chunker (target/max/min tokens; overlap off by default)
CHUNK_TARGET_TOKENS=500
CHUNK_MAX_TOKENS=800
CHUNK_MIN_TOKENS=120
CHUNK_OVERLAP_TOKENS=0
# Concurrency for page processing; retries per page before needs_review fallback
CONCURRENCY=4
MODEL_RETRIES=3
HTTP_RETRIES=6
# Cache for paid model calls (keyed by image hash + mode + model + prompt version)
CACHE_DIR=.cache/extractions
OUTPUT_DIR=out
# Optional cost estimation (USD per million tokens; 0 = don't estimate)
PRICE_PER_M_INPUT_TOKEN=0
PRICE_PER_M_OUTPUT_TOKEN=0

# ==========================================================================
# vLLM worker environment (read by modal/vllm_app.py at DEPLOY time)
# NOTE: modal/vllm_app.py reads os.environ at import — it does NOT load .env.
# Set these in the shell before deploying, e.g.:
#     set -a; source .env; set +a
#     python -m modal deploy modal/vllm_app.py
# ==========================================================================
# GPU class for the vLLM function. T4 fits the 4B-Instruct bf16 weights (~8 GB)
# with --enforce-eager and is available on this Modal workspace. Bigger models
# want A10G (~24 GB) or newer; note GPU availability varies by workspace/hour.
VLLM_GPU=T4
# Idle seconds for the vLLM function before it scales to zero
VLLM_SCALEDOWN_WINDOW=300
# vLLM --max-model-len
VLLM_MAX_MODEL_LEN=16384
