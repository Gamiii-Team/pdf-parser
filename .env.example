# Document → structured JSON — environment
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# Every variable read anywhere in this repository is documented here.

# ============================================================================
# Model backend for VLM work (figure enrichment + VLM-routed pages)
# ============================================================================
# groq | modal
#   groq  — Groq Cloud API (default). Requires GROQ_API_KEY.
#   modal — Modal-hosted vLLM serving Qwen3-VL via an OpenAI-compatible
#           endpoint. Requires VLLM_ENDPOINT_URL + VLLM_API_TOKEN.
VLM_BACKEND=groq

# --- Groq (https://console.groq.com/keys) ---
# Get a key at https://console.groq.com/keys — required for VLM_BACKEND=groq.
GROQ_API_KEY=
# qwen/qwen3.8-27b by default.
# Groq limits: <=3 images/request, <=20 MB/request, ~2048 prompt tokens/image.
GROQ_MODEL=qwen/qwen3.8-27b

# --- Modal vLLM (optional self-hosted Qwen3-VL endpoint) ---
# URL of a vLLM-compatible server, e.g. https://<app>.modal.run — the client
# appends /v1/chat/completions.
VLLM_ENDPOINT_URL=
# Bearer token for the endpoint (must match the server's --api-key).
VLLM_API_TOKEN=
# Model served by that vLLM app (HF repo id).
# Default Qwen3-VL-8B-Instruct-FP8 (~9 GB); escalate to a 27B model by editing.
VLLM_MODEL=Qwen/Qwen3-VL-8B-Instruct-FP8

# ============================================================================
# PPTX → PDF conversion (LibreOffice in Docker)
# ============================================================================
# PowerPoint decks are converted before analysis. The converter runs in a
# locked-down container: no network, non-root, read-only root fs, 1 GB memory,
# no swap, 100-PID cap, all capabilities dropped. Hidden and empty slides are
# never rendered or counted. Requires Docker, or a local LibreOffice install
# with PPTX_CONVERTER=host.
#
# Build the image once (see docker/converter/Dockerfile):
#   docker build -t pdf-parser-converter:latest docker/converter
# Mode: "docker" (default) or "host" (spawn local soffice).
# PPTX_CONVERTER=docker
# Image used when PPTX_CONVERTER=docker.
# PPTX_CONVERTER_IMAGE=pdf-parser-converter:latest
# Host mode: path to soffice/libreoffice.
# PPTX_SOFFICE_PATH=soffice
# Kill a conversion after N ms. NOTE: a cold LibreOffice alone takes 1-2 s;
# image-heavy decks can exceed the default. If legitimate decks time out, raise this.
# PPTX_CONVERT_TIMEOUT_MS=5000
# Max simultaneous conversions; excess jobs wait. 2 × (1 GB container) is tight.
# PPTX_CONVERT_CONCURRENCY=2
# Scratch root for per-job dirs (input copy + isolated soffice profile).
# PPTX_JOB_ROOT=data/convert
# --- Validation caps (content-based, never trusts zip headers) ---
# PPTX_MAX_FILE_BYTES=26214400
# PPTX_MAX_UNCOMPRESSED_BYTES=209715200
# PPTX_MAX_ENTRIES=1000
# PPTX_MAX_ENTRY_UNCOMPRESSED=52428800
# PPTX_MAX_ENTRY_RATIO=100
# PPTX_MAX_OVERALL_RATIO=50
# PPTX_MAX_MEDIA_FILES=200
# PPTX_MAX_IMAGE_PIXELS=10000
# PPTX_MAX_SLIDES=25

# ============================================================================
# Shared knobs
# ============================================================================
# Optional: override the Python interpreter the PyMuPDF worker uses.
# Default resolution: .venv/bin/python (→ .venv/Scripts/python.exe on Windows) → PYTHON → python3.
# PYTHON=/path/to/python3
#
# Pages with >= this many text-layer characters route to the born-digital path;
# otherwise (or when image coverage >= 0.9) they route to the VLM path.
MIN_CHARS_TEXT_LAYER=80
# Default render DPI for VLM crops (150-200 looks good).
DPI=170
CROP_DPI=200
# Concurrency for page/figure work; retries per model call.
CONCURRENCY=4
MODEL_RETRIES=3
HTTP_RETRIES=6
# Output
OUTPUT_DIR=out
# Optional cost estimation (USD per million tokens; 0 = don't estimate).
PRICE_PER_M_INPUT_TOKEN=0
PRICE_PER_M_OUTPUT_TOKEN=0
