# Figure Extraction — environment
# Copy to .env and fill in secrets. Never commit .env.

# --- Inference transport (Modal HTTP endpoint) ---
# URL printed by `modal deploy figure_extraction/florence.py`
MODAL_FLORENCE_URL=
# Random secret generated once with `openssl rand -hex 32`; the endpoint expects it
# as the X-API-Secret header and reads it from the `florence-api` Modal secret.
MODAL_API_SECRET=

# --- PDF -> JSON scenario (second Modal app, same secret) ---
# URL printed by `modal deploy figure_extraction/florence_pdf.py`
# (or written automatically by scripts/setup_modal.sh)
MODAL_PDF_EXTRACT_URL=

# --- Model ---
# florence-2-base | florence-2-large  (maps to microsoft/Florence-2-*-ft server-side)
VISION_MODEL=florence-2-large
