{
  "$id": "raw-element.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RawElement",
  "description": "Tolerant schema for model-returned elements. ids, source and needs_review are assigned by the pipeline, not the model.",
  "type": "object",
  "required": ["type"],
  "additionalProperties": true,
  "properties": {
    "type": {
      "type": "string",
      "enum": ["heading", "paragraph", "table", "figure", "equation", "code", "list", "caption"]
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "text": { "type": "string" },
    "level": { "type": "integer", "minimum": 1, "maximum": 6 },
    "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
    "header_rows": { "type": "integer", "minimum": 0 },
    "caption": { "type": ["string", "null"] },
    "figure_type": { "type": "string" },
    "description": { "type": "string" },
    "data": { "type": ["object", "null"] },
    "formula": { "type": "string" }
  }
}
