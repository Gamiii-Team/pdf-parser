{
  "$id": "chunk.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chunk",
  "type": "object",
  "required": [
    "id", "index", "section_path", "pages", "text",
    "token_estimate", "prev_id", "next_id", "needs_review", "elements"
  ],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "index": { "type": "integer", "minimum": 0 },
    "section_path": { "type": "array", "items": { "type": "string" } },
    "pages": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
    "text": { "type": "string" },
    "token_estimate": { "type": "integer", "minimum": 0 },
    "prev_id": { "type": ["string", "null"] },
    "next_id": { "type": ["string", "null"] },
    "needs_review": { "type": "boolean" },
    "overlap": { "type": "boolean" },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "element.schema.json" }
    }
  }
}
