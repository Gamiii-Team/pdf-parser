{
  "$id": "manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChunkedDocumentManifest",
  "type": "object",
  "required": ["document", "chunks"],
  "additionalProperties": false,
  "properties": {
    "document": {
      "type": "object",
      "required": ["source_file", "pages", "mode", "model", "schema_version", "created_at", "toc"],
      "additionalProperties": true,
      "properties": {
        "source_file": { "type": "string" },
        "pages": { "type": "integer", "minimum": 1 },
        "mode": { "type": "string", "enum": ["hybrid-florence", "full-florence", "full-groq", "full-modal", "full-qwen-8b", "full-qwen-27b"] },
        "model": { "type": "string" },
        "schema_version": { "type": "string" },
        "created_at": { "type": "string" },
        "dpi": { "type": "number" },
        "prompt_version": { "type": "string" },
        "toc": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "level", "chunk_ids"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "level": { "type": "integer", "minimum": 1 },
              "chunk_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
            }
          }
        }
      }
    },
    "chunks": {
      "type": "array",
      "items": { "$ref": "chunk.schema.json" }
    }
  }
}
